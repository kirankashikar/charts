# MySQL / MariaDB — every sheet, chart and published version is stored here.
# Hostinger: hPanel → Databases → MySQL, then use the host it shows (often localhost).
DATABASE_URL="mysql://user:password@localhost:3306/chartstudio"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client (Google Cloud console → Credentials → OAuth client ID → Web application).
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public origin used to build the shareable viewer links that slides point at.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required when self-hosting behind a proxy (not needed on Vercel).
AUTH_TRUST_HOST="true"
